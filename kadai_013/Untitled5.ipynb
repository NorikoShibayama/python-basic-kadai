      "source": [
        "# 商品価格と税率から、消費税を含む金額を返す関数\n",
        "\n",
        "#関数\n",
        "def calculate_item(product,tax):\n",
        "  result = product + (product * tax / 100)\n",
        "  return result\n",
        "\n",
        "# 引数、商品の金額「110」と消費税（10%）の「10」を渡す\n",
        "# 実行し、戻り値を表示\n",
        "print (calculate_item(110,10))"
      ]
    },
