      "source": [
        "# Humanクラス定義　属性：名前(name)、年齢(age)\n",
        "class Human:\n",
        "  def __init__(self,name: str,age: int):\n",
        "    self.name = name\n",
        "    self.age = age\n",
        "\n",
        "# 表示メソッド\n",
        "  def printinfo(self):\n",
        "    print(f\"氏名：{self.name}　年齢：{self.age}です。\")\n",
        "\n",
        "# インスタンス化\n",
        "human = Human(\"山田太郎\",35)\n",
        "\n",
        "# 表示メソッドの実行\n",
        "human.printinfo()"
      ]
    }
  ]
}